{
  "name": "firmware-release-recovery-lab-visualizer",
  "version": "0.2.1",
  "private": true,
  "description": "Editable offline release and recovery evidence studio",
  "type": "module",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run clean && tsc -p tsconfig.json && node scripts/build.mjs",
    "test": "npm run build && node --test build/tests/*.test.js",
    "smoke": "node scripts/smoke.mjs",
    "check:browser-host": "node scripts/check_browser_host.mjs chromium",
    "test:browser": "python ../tools/smoke_source.py --output ../.runtime/source-browser"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
