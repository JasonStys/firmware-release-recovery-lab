# File: .gitignore
# Purpose: Keeps compiler output, local labs, generated artifacts, and editor files untracked.
# Variables: none; patterns are repository-relative unless noted.
/target/
/artifacts/
/demo/
*.tmp
*.pending
.DS_Store
Thumbs.db
.idea/
.vscode/
/.runtime/
/.venv/
/release/
/web/node_modules/
/web/build/
/web/dist/
/web/test-results/
/web/playwright-report/
__pycache__/
.pytest_cache/
.ruff_cache/
.coverage*
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal

